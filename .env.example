# Copia este fichero a .env y rellena los valores. NUNCA subas .env al repositorio.

# --- Base de datos (PostgreSQL; con Podman: servicio `postgres` de compose.yaml) ---
DB_URL=jdbc:postgresql://localhost:5432/pawparazzi
DB_USER=pawparazzi
DB_PASSWORD=

# --- Autenticación ---
# Mínimo 32 bytes aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# --- Almacenamiento de imágenes ---
# local (ficheros en STORAGE_LOCAL_ROOT) | s3 (SeaweedFS de compose.yaml u otro proveedor compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/media
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pawparazzi-media
# Las usa tanto SeaweedFS (compose.yaml) como el backend. Genera valores aleatorios.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
# Crea el bucket al arrancar si no existe (recomendado en desarrollo; en producción, aprovisiónalo aparte).
S3_CREATE_BUCKET=true

# --- Revisión automática de fotos (opcional) ---
# none  = sin revisión: se acepta cualquier imagen válida.
# local = el contenedor "moderation" de compose.yaml comprueba que haya un animal y que no haya
#         violencia ni contenido sexual. Modelo abierto en tu propio servidor: sin coste por foto.
MODERATION_PROVIDER=local
MODERATION_URL=http://localhost:8090
# Si el servicio falla o no responde: allow = se acepta sin revisar | reject = se rechaza la subida.
MODERATION_ON_ERROR=allow
# Umbrales (0 a 1). Súbelos para rechazar menos; bájalos para rechazar más. Ver moderation/README.md.
MODERATION_ANIMAL_THRESHOLD=0.5
MODERATION_VIOLENCE_THRESHOLD=0.85
MODERATION_SEXUAL_THRESHOLD=0.85

# --- Web / CORS (Flutter web en local) ---
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
AUTH_RATE_LIMIT_PER_MINUTE=20
